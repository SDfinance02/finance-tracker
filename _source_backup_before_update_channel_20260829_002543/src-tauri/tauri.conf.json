{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finance Tracker",
  "version": "2.2.0",
  "identifier": "be.local.financetracker.v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Finance Tracker",
        "width": 1440,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Private, local-first personal finance tracker",
    "longDescription": "A private local-first personal finance, investment and wealth management dashboard with SQLite storage.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": ""
    }
  }
}
